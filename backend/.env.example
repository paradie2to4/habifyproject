# =============================================================================
# Habify BACKEND (Spring Boot → Render) + Neon PostgreSQL
# Copy to `backend/.env` for local runs. On Render, set these as Environment vars.
# =============================================================================

# --- Neon PostgreSQL (from Neon Console → Connection details → JDBC) ---
# Format: jdbc:postgresql://HOST/DB?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Server ---
# Local default 8080. Render injects PORT automatically — keep SERVER_PORT optional.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- JWT (use a long random secret in production) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# --- CORS: comma-separated frontend origins (Vercel + local) ---
# After Vercel deploy, add https://your-app.vercel.app (and preview URLs if needed)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
