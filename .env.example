# =============================================================================
# Habify FRONTEND (Vite → Vercel)
# Copy to `.env` for local development. On Vercel, set these in Project Settings.
# Never put database passwords or JWT secrets here — those belong in backend/.env
# =============================================================================

# Local: use Vite proxy → http://localhost:8080
VITE_API_BASE_URL=/api

# Production (Vercel): set to your Render API URL, including /api
# Example: VITE_API_BASE_URL=https://habify-api.onrender.com/api
